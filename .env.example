NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Clinicorp settings belong in Supabase Edge Function Secrets. Never use NEXT_PUBLIC.
# For Salto use CLINICORP_SALTO_API_USERNAME, CLINICORP_SALTO_API_TOKEN and CLINICORP_SALTO_SUBSCRIBER_ID.
# Optional JSON alternative for multiple CPE units:
# CLINICORP_UNIT_CONFIG={"unit-uuid":{"username":"YOUR_READONLY_USER","token":"YOUR_API_TOKEN","subscriberId":"YOUR_SUBSCRIBER_ID"}}
